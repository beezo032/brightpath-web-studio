{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/portfolio/:slug", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/dental-web-design", "destination": "/index.html" },
    { "source": "/landscaper-web-design", "destination": "/index.html" },
    { "source": "/contractor-web-design", "destination": "/index.html" },
    { "source": "/hvac-web-design", "destination": "/index.html" },
    { "source": "/barbershop-web-design", "destination": "/index.html" },
    { "source": "/charleston-sc-web-design", "destination": "/index.html" },
    { "source": "/summerville-sc-web-design", "destination": "/index.html" },
    { "source": "/goose-creek-web-design", "destination": "/index.html" }
  ]
}
